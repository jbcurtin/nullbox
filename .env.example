# Copy to .env for local development (read by dotenvy). All settings: crates/api/src/config.rs
BIND_ADDR=127.0.0.1:3000
DATABASE_URL=sqlite://nullbox.db
# Build against the .sqlx cache: with DATABASE_URL alone, compiling fails until nullbox.db exists.
SQLX_OFFLINE=true
# Comma-separated. The web app runs on a different origin, like a Tauri webview would.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where the web app lives; secret access links point here.
PUBLIC_WEB_URL=http://localhost:5173
# Required: unlocks GET /api/admin/export (header X-Admin-Token). At least 32 characters.
# Generate one with: echo "ADMIN_TOKEN=$(openssl rand -hex 32)" >> .env
# ADMIN_TOKEN=
# Worker accounts: anyone can create one on /inbox (each logs in once). Set a code here
# to require it at sign-up; hand it to your team.
# WORKER_SIGNUP_CODE=
# Optional: the bearer token for the MCP server at /mcp. At least 32 characters.
# MCP_TOKEN=
# Optional: the Stripe secret key (sk_test_...), for the shop at /shop.
# STRIPE_API_KEY=
# Optional: export traces and logs over OTLP (http/protobuf), e.g. to a local collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
RUST_LOG=info,tower_http=debug
