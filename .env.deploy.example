# Copy to .env on the server, next to compose.yaml.
DOMAIN=team-07.fasthacks.cloud
# Required: the API refuses to start without it.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
# The worker inbox login. Unset, nobody can log in. Password: at least 12 characters.
# Generate one with: openssl rand -base64 18
WORKER_USERNAME=worker
WORKER_PASSWORD=
# Optional: the bearer token for the MCP server at /mcp. Without it, /mcp refuses everyone.
# Generate one the same way.
MCP_TOKEN=
# Optional: the Stripe secret key, for the shop. Without it, checkout answers 503.
STRIPE_API_KEY=
# Optional: where OpenTelemetry traces and logs go (OTLP over http/protobuf). Without an
# endpoint, nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
