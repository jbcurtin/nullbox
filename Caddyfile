# SITE_ADDRESS is the domain (e.g. team-07.fasthacks.cloud): Caddy gets a Let's Encrypt
# certificate for it automatically. Defaults to localhost for a local run.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# The API, and its MCP server for agents.
	@api path /api/* /mcp /mcp/*
	handle @api {
		reverse_proxy api:3000
	}

	# Machine-readable files must be real files or a 404, never the SPA's index.html:
	# crawlers and Lighthouse would read that HTML as a broken manifest.
	@machine path /.well-known/* /robots.txt /llms.txt /sitemap.xml
	handle @machine {
		root * /srv
		file_server
	}

	# The SPA: unknown paths (/inbox, /t/...) fall back to index.html for the client router.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
